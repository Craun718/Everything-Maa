{
  "mcpServers": {
    "maa-mcp": {
      "command": "uvx",
      "args": [
        "--from",
        "maa-mcp==1.2.3",
        "maa-mcp"
      ]
    },
    "create-maa-project": {
      "command": "uvx",
      "env": {
        "CREATE_MAA_PROJECT_AUTO_UPDATE": "0"
      },
      "args": [
        "--from",
        "create-maa-project==3.2.0",
        "create-maa-project",
        "--mcp"
      ]
    },
    "playwright": {
      "command": "npx",
      "args": [
        "--yes",
        "@playwright/mcp@0.0.78",
        "--isolated"
      ]
    }
  }
}
