{
  "schemaVersion": 1,
  "tools": {
    "maa-mcp": {
      "role": "persistent-runtime",
      "description": "Use for persistent device sessions and exploratory recognition, interaction, and Pipeline debugging.",
      "mcpServer": "maa-mcp"
    },
    "create-maa-project": {
      "role": "project-lifecycle",
      "description": "Use for deterministic Maa project creation, structured updates, doctor, diff, and release scaffolding.",
      "mcpServer": "create-maa-project",
      "cli": {
        "command": "uvx",
        "args": [
          "--from",
          "create-maa-project==2.0.0",
          "create-maa-project"
        ],
        "reportFlag": "--report"
      }
    },
    "maafw-cli": {
      "role": "batch-runtime",
      "description": "Use for low-context, repeatable MaaFramework device and Pipeline operations with strict JSON output.",
      "status": "experimental",
      "verifiedAt": "2026-07-15",
      "capabilities": [
        "device-discovery",
        "named-sessions",
        "recognition-actions",
        "pipeline-validation",
        "pipeline-execution",
        "strict-json"
      ],
      "package": "maafw-cli",
      "version": "0.1.6",
      "license": "MIT",
      "upstream": "https://github.com/otowa-kotori/maafw-cli",
      "cli": {
        "command": "uvx",
        "args": [
          "--from",
          "maafw-cli==0.1.6",
          "maafw-cli"
        ],
        "jsonFlag": "--json"
      }
    },
    "maa-evidence-kit": {
      "role": "diagnostic-runtime",
      "description": "Use for read-only cross-tool MaaFramework failure diagnosis over local logs and project sources when the failure owner is unknown.",
      "status": "external-optional",
      "verifiedAt": "2026-08-28",
      "capabilities": [
        "runtime-discovery",
        "cross-tool-inspection",
        "log-evidence",
        "static-project-evidence",
        "local-corpus-inventory",
        "structured-json"
      ],
      "package": "maa-evidence-kit",
      "version": "0.3.2",
      "supportedRange": ">=0.3.0 <0.4.0",
      "license": "MIT",
      "upstream": "https://github.com/Windsland52/MaaEvidenceKit",
      "formerName": "MaaDiagnosticExpert",
      "executable": "maa-evidence",
      "schemas": [
        "maa-evidence/v1",
        "maa-evidence-batch/v1",
        "maa-evidence-profile/v1"
      ],
      "install": "user-managed",
      "mcpSurface": "none-at-0.3.x"
    },
    "playwright": {
      "role": "optional-web-runtime",
      "description": "Use only when Maa work requires browser-side documentation, UI observation, or web testing.",
      "mcpServer": "playwright"
    }
  }
}
